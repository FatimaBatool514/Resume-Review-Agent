# Copy this file to .streamlit/secrets.toml for local development,
# or paste its contents into the "Secrets" section of your app settings
# on Streamlit Community Cloud. Never commit your real secrets.toml file.

GROQ_API_KEY = "your-groq-api-key-here"

# Optional: override the default model.
# Must be a currently supported/active Groq production model.
GROQ_MODEL = "openai/gpt-oss-120b"
